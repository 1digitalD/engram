{
  "_comment": "Add the 'engram' block into your ~/.claude/claude_desktop_config.json mcpServers section",
  "mcpServers": {
    "engram": {
      "command": "python",
      "args": ["/path/to/engram/mcp_server/server.py"],
      "env": {
        "ENGRAM_API_BASE": "http://localhost:5001/api/v4",
        "TRANSPORT": "stdio"
      }
    }
  }
}
