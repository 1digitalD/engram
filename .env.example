# Flask
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=change-me-in-production

# Database - Postgres + pgvector for fresh v4 runtime
DATABASE_URL=postgresql://engram:engram@localhost:5432/engram
TEST_DATABASE_URL=postgresql://engram:engram@localhost:5433/engram_test

# Port — must match ui/vite.config.js proxy target
PORT=5001

# OpenAI (required for AI features)
OPENAI_API_KEY=sk-...

# v4 chat model overrides (SQ-00 prod policy: -mini for judgment paths, -nano for summarization)
# Code default when unset: gpt-5.4-nano (see services/llm_models.py)
OPENAI_EXTRACTION_MODEL=gpt-5.4-mini
OPENAI_RECONCILIATION_MODEL=gpt-5.4-mini
OPENAI_ACTIVITY_UPDATE_MODEL=gpt-5.4-mini
OPENAI_DECISION_MODEL=gpt-5.4-mini
OPENAI_BRIEF_MODEL=gpt-5.4-mini
OPENAI_SUMMARIZATION_MODEL=gpt-5.4-nano

# Anthropic (required for summarization)
ANTHROPIC_API_KEY=sk-ant-...

# AI pipeline thresholds
CLASSIFY_CONFIDENCE_THRESHOLD=0.70
AUTOLINK_CONFIDENCE_NEW_ENTITY=0.92
EMBED_MODEL=text-embedding-3-small
EMBED_DIMS=1536

# Job worker
JOB_POLL_INTERVAL=5
JOB_MAX_ATTEMPTS=3

# Logging
LOG_LEVEL=INFO

# MCP server - v4 read-only tools
# ENGRAM_API_BASE=http://localhost:5001/api/v4
# TRANSPORT=stdio
# MCP_PORT=8765
