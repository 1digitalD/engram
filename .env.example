# Flask
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=change-me-in-production

# Database (SQLite default)
DATABASE_URL=sqlite:///engram.db

# Port — must match ui/vite.config.js proxy target
PORT=5001

# OpenAI (required for AI features)
OPENAI_API_KEY=sk-...

# Logging
LOG_LEVEL=INFO

# MCP server (configure these in your shell or mcp/server.py environment)
# ENGRAM_API_BASE=http://localhost:5001/api/v1
# TRANSPORT=stdio    # or: http
# MCP_PORT=8765      # only when TRANSPORT=http
